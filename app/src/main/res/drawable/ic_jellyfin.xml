<?xml version="1.0" encoding="utf-8"?>
<!--
    Jellyfin logo: rounded hollow triangle (ring)
    Viewport 100x100 for bezier precision.
    Outer triangle vertices: (50,8) (92,81) (8,81)
    Inner triangle vertices: (50,36) (68,67) (32,67)
    fillType=evenOdd creates the hollow center.
    Corner radius ~8 (outer) ~4 (inner) using quadratic beziers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillType="evenOdd"
        android:pathData="
            M 46,15 Q 50,8 54,15
            L 88,74 Q 92,81 84,81
            L 16,81 Q 8,81 12,74
            Z
            M 48,39.5 Q 50,36 52,39.5
            L 66,63.5 Q 68,67 64,67
            L 36,67 Q 32,67 34,63.5
            Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="44"
                android:endX="92"
                android:endY="44">
                <item android:offset="0" android:color="#AA5CC3"/>
                <item android:offset="1" android:color="#00A4DC"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
